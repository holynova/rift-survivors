{
  "name": "rift-survivors",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests *.ts",
    "preview": "vite preview --host 127.0.0.1 --port 5189 --strictPort",
    "test:balance": "node scripts/balance-check.mjs",
    "test:perf": "node scripts/browser-performance.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "deploy": "npm run build && node scripts/write-release-manifest.mjs && npx --yes wrangler@4.128.0 deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "phaser": "3.90.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
